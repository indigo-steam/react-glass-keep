[Unit]
Description=Hermes Waker (start/stop per-user Hermes containers on demand)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/hermes-waker.env
ExecStart=/usr/bin/python3 /opt/hermes-waker/hermes-waker.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
